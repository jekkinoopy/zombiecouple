:root {
    --night: #4a3577;
    --night-deep: #34255c;
    --night-mid: #6a4fa0;
    --moon: #fff6da;
    --moon-glow: rgba(255, 246, 218, 0.55);
    --moon-dim: #e4d6ff;
    --cream: #fffaf1;
    --cream-shadow: #ffe9d2;
    --pumpkin: #ff9d4d;
    --pumpkin-bright: #ffb457;
    --pumpkin-dark: #f2792a;
    --ink: #4a3768;
    --ink-soft: #8b7aa8;
    --mint: #9fe8c8;
    --pink: #ffb3cb;
    --lilac: #c9b6f0;
    --line: rgba(74, 55, 104, 0.14);
    --card-lift: 0 18px 36px rgba(58, 38, 92, 0.28);
    font-size: 18px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    position: relative;
    background-color: var(--night);
    background-image:
        radial-gradient(circle at 85% 10%, var(--moon) 0%, var(--moon) 4%, transparent 4.4%),
        radial-gradient(circle at 85% 10%, var(--moon-glow) 0%, transparent 16%),
        radial-gradient(circle at 12% 22%, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0.5) 1.4%, transparent 1.6%),
        radial-gradient(circle at 28% 8%, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.4) 1%, transparent 1.2%),
        radial-gradient(circle at 68% 30%, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0.35) 1%, transparent 1.2%),
        radial-gradient(circle at 45% 4%, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.4) 0.8%, transparent 1%),
        linear-gradient(180deg, var(--night) 0%, var(--night-deep) 55%, #2a1e4d 100%);
    color: var(--cream);
    font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
    line-height: 1.75;
    letter-spacing: 0.03em;
    min-height: 100vh;
}

.shop-header,
.main-section,
.site-footer {
    position: relative;
    z-index: 1;
}

.shop-header {
    padding: clamp(1.5rem, 4vw, 2.75rem) clamp(0.75rem, 3vw, 1.5rem) 0;
}

.hero-card {
    max-width: 940px;
    margin: 0 auto;
    border-radius: 28px;
    overflow: hidden;
    background: var(--cream);
    border: 4px solid var(--cream);
    box-shadow:
        var(--card-lift),
        0 0 0 3px var(--pumpkin);
}

.hero-art {
    background: var(--night-deep);
    line-height: 0;
    position: relative;
}

.hero-art__badge {
    position: absolute;
    top: 14px;
    right: 14px;
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.35));
    z-index: 1;
    transform: rotate(8deg);
}

.hero-art__img {
    width: 100%;
    height: auto;
    display: block;
    filter: contrast(1.02) saturate(1.08) brightness(1.02);
}

/* 可愛糖果條紋分隔 */
.hero-bar {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.65rem);
    padding: clamp(1rem, 3vw, 1.35rem);
    position: relative;
    overflow: hidden;
    background: var(--cream);
    border-top: 4px dashed var(--pumpkin);
}

.hero-bar__mark,
.hero-bar__copy {
    position: relative;
    z-index: 1;
}

.hero-bar__mark {
    flex-shrink: 0;
}

.hero-bar__logo {
    width: clamp(56px, 11vw, 86px);
    height: clamp(56px, 11vw, 86px);
    object-fit: cover;
    display: block;
    border-radius: 50%;
    border: 3px solid var(--pumpkin);
    box-shadow:
        0 0 0 3px var(--cream),
        0 0 0 5px var(--lilac),
        0 6px 0 rgba(74, 55, 104, 0.15);
    background: var(--cream);
}

.hero-bar__copy {
    flex: 1;
    min-width: 0;
    text-align: left;
}

.hero-bar__brand {
    font-family: "Baloo 2", "Noto Sans TC", cursive;
    font-size: clamp(1.1rem, 3.4vw, 1.6rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--pumpkin-dark);
    line-height: 1.1;
}

.hero-bar__copy h1 {
    font-family: "Noto Sans TC", sans-serif;
    font-size: clamp(1.15rem, 3.2vw, 1.75rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    color: var(--ink);
    line-height: 1.35;
    margin-top: 0.2rem;
}

.hero-bar__tag {
    font-family: "Baloo 2", "Noto Sans TC", sans-serif;
    font-size: clamp(0.85rem, 2.1vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    margin-top: 0.25rem;
}

/* 糖果紙質感內容區 */
.main-section {
    width: min(94%, 1020px);
    margin: clamp(1.5rem, 4vw, 2.5rem) auto clamp(3.5rem, 8vw, 5rem);
    padding: clamp(1.15rem, 3vw, 2rem);
    color: var(--ink);
    background: var(--cream);
    border-radius: 28px;
    border: 4px solid var(--cream);
    box-shadow:
        var(--card-lift),
        0 0 0 3px var(--lilac);
    position: relative;
}

.main-section::before {
    content: "🍬";
    position: absolute;
    top: -14px;
    right: 22px;
    font-size: 1.6rem;
    transform: rotate(-12deg);
    filter: drop-shadow(0 3px 4px rgba(74, 55, 104, 0.25));
}

.table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-top: clamp(0.5rem, 2vw, 1rem);
    border-radius: 18px;
    border: 3px solid var(--line);
    background: #fff;
    box-shadow: inset 0 2px 8px rgba(74, 55, 104, 0.06);
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0;
}

.product-table {
    margin-top: 0;
    min-width: 720px;
}

th {
    background: linear-gradient(180deg, var(--pumpkin) 0%, var(--pumpkin-dark) 100%);
    color: #fff;
    font-size: 0.76rem;
    padding: 14px;
    text-align: left;
    font-weight: 700;
    letter-spacing: 0.16em;
    font-family: "Baloo 2", "Noto Sans TC", sans-serif;
}

thead th:first-child {
    border-top-left-radius: 14px;
}

thead th:last-child {
    border-top-right-radius: 14px;
}

tbody tr:nth-child(even) td:not(.img) {
    background-color: rgba(201, 182, 240, 0.12);
}

tr:hover td {
    background-color: rgba(255, 157, 77, 0.1);
}

.img {
    width: 320px;
    height: 320px;
    padding: 0 !important;
    overflow: hidden;
    position: relative;
    border: 3px dashed var(--pumpkin);
    box-shadow: inset 0 0 0 6px #fff;
}

.img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    filter: saturate(1.05) brightness(1.01);
    transition: transform 0.45s ease, filter 0.35s ease;
}

.img.sc img {
    transform: scale(1.1);
}

.img:hover img {
    transform: scale(1.05) rotate(-1deg);
}

.img.sc:hover img {
    transform: scale(1.15) rotate(-1deg);
}

td:not(.img) {
    font-size: 0.9rem;
    color: var(--ink);
    padding: 18px 20px;
    letter-spacing: 0.04em;
    vertical-align: top;
    border-bottom: 2px dotted var(--line);
    font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
}

.product-info {
    font-weight: 700;
}

.product-price::before {
    content: "$";
    color: var(--pumpkin-dark);
    font-weight: 700;
    margin-right: 2px;
}

input[type="text"],
input[type="number"],
textarea {
    width: 100%;
    padding: 8px 10px;
    background-color: #fff;
    border: 2px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    font-family: "Noto Sans TC", sans-serif;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

input:focus,
textarea:focus {
    border-color: var(--pumpkin);
    box-shadow: 0 0 0 3px rgba(255, 157, 77, 0.25);
}

.qty input[type="number"],
.line-total input[type="number"] {
    max-width: 5.5rem;
    margin: 0 auto;
    display: block;
    text-align: center;
}

input::placeholder {
    color: var(--ink-soft);
    opacity: 0.6;
}

/* 可愛萬聖夜須知卡 */
.notice-section {
    margin-top: clamp(2rem, 5vw, 3rem);
    padding: clamp(1.4rem, 3.5vw, 2rem);
    background: linear-gradient(165deg, var(--lilac) 0%, var(--pink) 100%);
    color: var(--ink);
    border-radius: 24px;
    border: 3px solid #fff;
    box-shadow:
        var(--card-lift),
        inset 0 0 0 2px rgba(255, 255, 255, 0.5);
    position: relative;
    overflow: hidden;
    font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
}

.notice-section::before {
    content: "👻";
    position: absolute;
    top: -18px;
    right: -10px;
    font-size: 4.5rem;
    opacity: 0.25;
    transform: rotate(12deg);
    pointer-events: none;
}

.notice-title {
    font-size: clamp(1rem, 2.8vw, 1.35rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--pumpkin-dark);
    margin-bottom: 1.2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15em;
    position: relative;
    z-index: 1;
}

.notice-title__en {
    font-family: "Baloo 2", cursive;
    letter-spacing: 0.02em;
}

.notice-title__zh {
    font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
    font-weight: 700;
    letter-spacing: 0.1em;
}

.notice-title__sep {
    font-family: "Noto Sans TC", sans-serif;
    opacity: 0.55;
}

.notice-title::before {
    content: "🎃";
    margin-right: 10px;
    font-size: 1.05rem;
}

ul.notice-list {
    list-style: none;
    padding: 0;
    position: relative;
    z-index: 1;
}

ul.notice-list li {
    font-size: 0.92rem;
    color: var(--ink);
    margin-bottom: 1rem;
    line-height: 1.8;
    display: flex;
    align-items: flex-start;
    font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
}

ul.notice-list li::before {
    content: "🍭";
    font-size: 0.85rem;
    margin-right: 12px;
    margin-top: 2px;
    flex-shrink: 0;
}

.highlight-text {
    color: var(--pumpkin-dark);
    font-weight: 700;
    text-decoration: underline wavy var(--pumpkin);
    text-underline-offset: 3px;
}

.site-footer {
    text-align: center;
    padding: clamp(2rem, 4vw, 2.75rem) 1.25rem;
    position: relative;
}

.site-footer p {
    margin: 0.35rem 0;
    font-family: "Baloo 2", cursive;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 700;
    color: var(--moon);
}

.site-footer__rights {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--moon-dim);
    text-transform: uppercase;
    font-family: "Noto Sans TC", "PingFang TC", sans-serif;
    font-weight: 500;
    opacity: 0.75;
}

@media (max-width: 560px) {
    .hero-bar {
        flex-direction: column;
        text-align: center;
    }

    .hero-bar__copy {
        text-align: center;
        width: 100%;
    }

    .img {
        width: 240px;
        height: 240px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .img img {
        transition: none;
    }
}
